# Neon Postgres
# DATABASE_URL = pooled host (...-pooler....) for the Next.js app
# DIRECT_URL   = non-pooler host for Prisma migrate
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pool_timeout=30"
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=

# Overdue / due notification cron
CRON_SECRET=
OVERDUE_NOTIFY_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Public origin for email deep links (e.g. https://your-app.vercel.app)
APP_BASE_URL=
