# Neon Postgres
# DATABASE_URL = pooled host (...-pooler....) for the Next.js app
# DIRECT_URL   = non-pooler host for Prisma migrate
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pool_timeout=30"
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=

# Overdue / due notification cron
CRON_SECRET=
OVERDUE_NOTIFY_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Public origin for email deep links (e.g. https://your-app.vercel.app)
APP_BASE_URL=

# Excel -> PDF conversion (self-hosted Gotenberg — see infra/gotenberg/README.md).
# Leave unset to keep "Convert to PDF" disabled with a clear error instead of failing.
GOTENBERG_URL=
GOTENBERG_BASIC_AUTH_USER=
GOTENBERG_BASIC_AUTH_PASSWORD=

# File storage: Vercel Dashboard -> Storage -> Create Database -> Blob, then
# "Connect Project" — Vercel sets this automatically for every environment it's
# linked to (Production/Preview/Development). Leave unset for local dev, which
# falls back to the uploads/ folder on disk (see get-file-storage.ts). Required
# before deploying — Vercel's serverless functions can't write to local disk.
BLOB_READ_WRITE_TOKEN=
