generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled URL for the app; directUrl for Prisma migrate
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
}

enum LpoStatus {
  LPO_RECEIVED
  UNDER_REVIEW
  ASSIGNED_TO_MANUFACTURER
  CLIENT_DELIVERY_COMPLETED
}

enum LpoDateField {
  ASSIGNMENT
  PRODUCTION_DEADLINE
  CLIENT_DELIVERY
}

enum FabricMovementType {
  RECEIVED
  ISSUED
  USED_FOR_LPO
  RETURNED
  ADJUSTMENT
}

enum FabricVarianceReason {
  CUTTING_WASTAGE
  DAMAGE
  SIZE_ALTERATION
  PRODUCTION_MISTAKE
  OTHER
}

enum NotificationType {
  REVIEW_PENDING
  ASSIGNMENT_OVERDUE
  PRODUCTION_OVERDUE
  CLIENT_DELIVERY_OVERDUE
}

enum NotificationEmailStatus {
  PENDING
  SENT
  DRY_RUN
  FAILED
}

enum DocumentType {
  QUOTATION
  QUOTE
  TAX_INVOICE
  DELIVERY_NOTE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(ADMIN)
  googleSub String?  @unique @map("google_sub")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lposCreated       Lpo[]              @relation("LpoCreatedBy")
  lpoDateChanges    LpoDateChange[]
  manufacturersCreated Manufacturer[]  @relation("ManufacturerCreatedBy")
  fabricInvoices    FabricSupplierInvoice[]
  fabricMovements   FabricMovement[]
  fabricVariances   FabricVariance[]
  auditLogs         AuditLog[]
  generatedDocuments GeneratedDocument[]

  @@map("users")
}

model Manufacturer {
  id              String   @id @default(cuid())
  name            String
  nameNormalized  String   @unique @map("name_normalized")
  isActive        Boolean  @default(true) @map("is_active")
  createdById     String?  @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  createdBy User? @relation("ManufacturerCreatedBy", fields: [createdById], references: [id])
  lpos      Lpo[]
  movements FabricMovement[]
  variances FabricVariance[]

  @@index([isActive])
  @@map("manufacturers")
}

model Lpo {
  id                         String    @id @default(cuid())
  lpoNumber                  String    @unique @map("lpo_number")
  nickname                   String
  clientName                 String    @map("client_name")
  lpoDate                    DateTime  @db.Date @map("lpo_date")
  receivedDate               DateTime  @db.Date @map("received_date")
  originalFileKey            String    @map("original_file_key")
  originalFileName           String    @map("original_file_name")
  originalMimeType           String    @map("original_mime_type")
  status                     LpoStatus @default(LPO_RECEIVED)
  manufacturerAssignmentAt   DateTime  @map("manufacturer_assignment_at")
  productionDeadlineAt       DateTime  @map("production_deadline_at")
  clientDeliveryAt           DateTime  @map("client_delivery_at")
  manufacturerId             String?   @map("manufacturer_id")
  productionFileKey          String?   @map("production_file_key")
  productionFileName         String?   @map("production_file_name")
  productionMimeType         String?   @map("production_mime_type")
  clientDeliveredAt          DateTime? @map("client_delivered_at")
  createdById                String    @map("created_by_id")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  /// Client/commercial details captured for document generation (Quotation/Quote/Invoice/Delivery Note).
  clientSubEntityName        String?   @map("client_sub_entity_name")
  clientTrn                  String?   @map("client_trn")
  invoiceAddress             String?   @map("invoice_address") @db.Text
  deliveryAddress            String?   @map("delivery_address") @db.Text
  /// Delivery-site abbreviation used in generated document numbers (e.g. "AHO").
  siteCode                   String?   @map("site_code")
  paymentTerms               String?   @map("payment_terms")
  deliveryTerms              String?   @map("delivery_terms")
  currency                   String    @default("AED")

  createdBy      User                @relation("LpoCreatedBy", fields: [createdById], references: [id])
  manufacturer   Manufacturer?       @relation(fields: [manufacturerId], references: [id])
  dateChanges    LpoDateChange[]
  fabricRequirements LpoFabricRequirement[]
  lineItems      LpoLineItem[]
  movements      FabricMovement[]
  variances      FabricVariance[]
  notifications  Notification[]
  documents      GeneratedDocument[]

  @@index([status])
  @@index([manufacturerAssignmentAt])
  @@index([productionDeadlineAt])
  @@index([clientDeliveryAt])
  @@index([manufacturerId])
  @@map("lpos")
}

model LpoDateChange {
  id          String       @id @default(cuid())
  lpoId       String       @map("lpo_id")
  field       LpoDateField
  oldValue    DateTime     @map("old_value")
  newValue    DateTime     @map("new_value")
  reason      String?
  changedById String       @map("changed_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")

  lpo       Lpo  @relation(fields: [lpoId], references: [id], onDelete: Cascade)
  changedBy User @relation(fields: [changedById], references: [id])

  @@index([lpoId, createdAt])
  @@map("lpo_date_changes")
}

model LpoFabricRequirement {
  id                       String   @id @default(cuid())
  lpoId                    String   @map("lpo_id")
  garmentName              String   @map("garment_name")
  quantity                 Int
  metersPerUnit            Decimal  @map("meters_per_unit") @db.Decimal(12, 3)
  expectedMeters           Decimal  @map("expected_meters") @db.Decimal(12, 3)
  consumptionRateId        String?  @map("consumption_rate_id")
  createdAt                DateTime @default(now()) @map("created_at")

  lpo             Lpo                     @relation(fields: [lpoId], references: [id], onDelete: Cascade)
  consumptionRate GarmentConsumptionRate? @relation(fields: [consumptionRateId], references: [id])

  @@index([lpoId])
  @@map("lpo_fabric_requirements")
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  actorId    String?  @map("actor_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model FabricSupplierInvoice {
  id            String   @id @default(cuid())
  supplierName  String   @map("supplier_name")
  invoiceRef    String   @map("invoice_ref")
  receivedDate  DateTime @db.Date @map("received_date")
  invoiceFileKey  String? @map("invoice_file_key")
  invoiceFileName String? @map("invoice_file_name")
  invoiceMimeType String? @map("invoice_mime_type")
  createdById   String   @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  isActive      Boolean   @default(true) @map("is_active")

  createdBy User          @relation(fields: [createdById], references: [id])
  batches   FabricBatch[]

  @@index([supplierName])
  @@index([receivedDate])
  @@index([isActive])
  @@map("fabric_supplier_invoices")
}

model FabricBatch {
  id           String   @id @default(cuid())
  fabricCode   String   @unique @map("fabric_code")
  fabricType   String   @map("fabric_type")
  colour       String
  remarks      String?
  qtyReceived  Decimal  @map("qty_received") @db.Decimal(12, 3)
  invoiceId    String   @map("invoice_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  isActive     Boolean  @default(true) @map("is_active")

  invoice   FabricSupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  movements FabricMovement[]
  variances FabricVariance[]

  @@index([invoiceId])
  @@index([fabricType, colour])
  @@index([isActive])
  @@map("fabric_batches")
}

model FabricMovement {
  id             String              @id @default(cuid())
  type           FabricMovementType
  batchId        String              @map("batch_id")
  manufacturerId String?             @map("manufacturer_id")
  lpoId          String?             @map("lpo_id")
  /// Signed meters: receipts positive; issues/usage negative; returns positive.
  quantityMeters Decimal             @map("quantity_meters") @db.Decimal(12, 3)
  transportRef   String?             @map("transport_ref")
  note           String?
  createdById    String              @map("created_by_id")
  occurredAt     DateTime            @map("occurred_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  batch        FabricBatch    @relation(fields: [batchId], references: [id])
  manufacturer Manufacturer?  @relation(fields: [manufacturerId], references: [id])
  lpo          Lpo?           @relation(fields: [lpoId], references: [id])
  createdBy    User           @relation(fields: [createdById], references: [id])

  @@index([batchId, createdAt])
  @@index([manufacturerId, createdAt])
  @@index([lpoId])
  @@index([type])
  @@map("fabric_movements")
}

model GarmentConsumptionRate {
  id            String   @id @default(cuid())
  garmentName   String   @unique @map("garment_name")
  metersPerUnit Decimal  @map("meters_per_unit") @db.Decimal(12, 3)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  requirements LpoFabricRequirement[]

  @@map("garment_consumption_rates")
}

model FabricVariance {
  id             String               @id @default(cuid())
  batchId        String?              @map("batch_id")
  manufacturerId String?              @map("manufacturer_id")
  lpoId          String?              @map("lpo_id")
  expectedMeters Decimal              @map("expected_meters") @db.Decimal(12, 3)
  actualMeters   Decimal              @map("actual_meters") @db.Decimal(12, 3)
  differenceMeters Decimal            @map("difference_meters") @db.Decimal(12, 3)
  reason         FabricVarianceReason
  note           String?
  createdById    String               @map("created_by_id")
  createdAt      DateTime             @default(now()) @map("created_at")

  batch        FabricBatch?   @relation(fields: [batchId], references: [id])
  manufacturer Manufacturer?  @relation(fields: [manufacturerId], references: [id])
  lpo          Lpo?           @relation(fields: [lpoId], references: [id])
  createdBy    User           @relation(fields: [createdById], references: [id])

  @@index([lpoId])
  @@index([manufacturerId])
  @@map("fabric_variances")
}

/// One row of an LPO's commercial line items (source data for generated documents).
model LpoLineItem {
  id              String   @id @default(cuid())
  lpoId           String   @map("lpo_id")
  /// Display order within the LPO.
  position        Int
  /// Optional grouping label (e.g. "CHEF", "BARISTA") for role-grouped orders.
  category        String?
  description     String   @db.Text
  articleNo       String?  @map("article_no")
  quantity        Int
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  discountPercent Decimal  @default(0) @map("discount_percent") @db.Decimal(5, 2)
  lineTotal       Decimal  @map("line_total") @db.Decimal(14, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  lpo Lpo @relation(fields: [lpoId], references: [id], onDelete: Cascade)

  @@index([lpoId])
  @@map("lpo_line_items")
}

/// Single-row settings: Deezano's own letterhead/bank details for generated documents.
model CompanyProfile {
  id                String    @id
  legalName         String    @map("legal_name")
  trn               String?
  addressLine1      String?   @map("address_line1")
  addressLine2      String?   @map("address_line2")
  phone             String?
  email             String?
  website           String?
  bankName          String?   @map("bank_name")
  bankAccountName   String?   @map("bank_account_name")
  bankAccountNumber String?   @map("bank_account_number")
  bankIban          String?   @map("bank_iban")
  bankSwiftCode     String?   @map("bank_swift_code")
  defaultTermsText  String?   @map("default_terms_text") @db.Text
  defaultFooterText String?   @map("default_footer_text")
  updatedById       String?   @map("updated_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("company_profile")
}

/// Per (document type, calendar day) counter — atomic source for the daily sequence
/// number embedded in generated document numbers (e.g. the "09" in AHO-INV-23072026-09).
model DocumentSequence {
  id           String       @id @default(cuid())
  type         DocumentType
  calendarDay  DateTime     @map("calendar_day") @db.Date
  lastSequence Int          @default(0) @map("last_sequence")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@unique([type, calendarDay])
  @@map("document_sequences")
}

/// One row per generated Quotation/Quote/Tax Invoice/Delivery Note file — the audit
/// trail and re-download source. Keeps its own snapshot of the data used so a document
/// generated today still reads the same on re-download even if the LPO or company
/// profile changes afterwards.
model GeneratedDocument {
  id             String       @id @default(cuid())
  type           DocumentType
  documentNumber String       @unique @map("document_number")
  lpoId          String       @map("lpo_id")
  fileKey        String       @map("file_key")
  fileName       String       @map("file_name")
  mimeType       String       @map("mime_type")
  /// Set once someone converts the Excel file to PDF (Phase 3) — same document,
  /// second artifact, converted on demand rather than at generation time.
  pdfFileKey     String?      @map("pdf_file_key")
  pdfFileName    String?      @map("pdf_file_name")
  /// Frozen copy of the company profile, client details, and line items used to fill
  /// this document — never re-read live from the LPO after generation.
  snapshot       Json
  generatedById  String       @map("generated_by_id")
  generatedAt    DateTime     @default(now()) @map("generated_at")

  lpo         Lpo  @relation(fields: [lpoId], references: [id], onDelete: Restrict)
  generatedBy User @relation(fields: [generatedById], references: [id])

  @@index([lpoId])
  @@index([type, generatedAt])
  @@map("generated_documents")
}

model Notification {
  id           String                   @id @default(cuid())
  type         NotificationType
  lpoId        String                   @map("lpo_id")
  dueAt        DateTime?                @map("due_at")
  businessDay  DateTime?                @map("business_day") @db.Date
  /// Stable unique key for idempotency (overdue: id+type+dueAt ISO; pending: id+type+YYYY-MM-DD).
  dedupeKey    String                   @unique @map("dedupe_key")
  title        String
  body         String
  actionPath   String                   @map("action_path")
  emailStatus  NotificationEmailStatus  @default(PENDING) @map("email_status")
  emailSentAt  DateTime?                @map("email_sent_at")
  readAt       DateTime?                @map("read_at")
  recipient    String
  createdAt    DateTime                 @default(now()) @map("created_at")

  lpo Lpo @relation(fields: [lpoId], references: [id], onDelete: Cascade)

  @@index([readAt, createdAt])
  @@index([type, createdAt])
  @@index([lpoId, createdAt])
  @@map("notifications")
}
